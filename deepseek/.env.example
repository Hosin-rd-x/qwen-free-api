# Copy to .env (start.sh does this automatically). Login is done by hand in a
# browser window (python -m deepseek.auth --account main), so no password or
# API key is stored here.

# --- Optional ---
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=30               # per-client-IP limit on /v1 endpoints

# --- Multi-account pool ---
# Extra bearer tokens (comma or newline separated) used as token-only accounts
# in addition to saved browser sessions. Most users can leave this empty.
# DEEPSEEK_TOKENS=

# Where account session files live (default: session/accounts)
# DEEPSEEK_ACCOUNTS_DIR=session/accounts

# Base cooldown (seconds) for a rate-limited account; doubles per consecutive
# 429, capped at 30 minutes.
# DEEPSEEK_COOLDOWN_BASE=120

# Set to 0/false on headless servers: without a saved session the API then
# returns a clear 503 instead of trying to pop open a browser window.
# SERVER_INTERACTIVE_LOGIN=1
